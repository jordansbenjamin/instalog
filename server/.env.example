# instalog server environment (sub-phase 1)
# Copy to server/.env and adjust. These are SERVER-only vars — never VITE_* (those leak into the SPA bundle).

# Port the Express API listens on (default: 3000)
PORT=3000

# Runtime mode: development | production | test (default: development)
NODE_ENV=development

# --- Atlassian OAuth 2.0 (3LO) app — register at developer.atlassian.com (REQUIRED) ---
ATLASSIAN_CLIENT_ID=your_client_id_here
ATLASSIAN_CLIENT_SECRET=your_client_secret_here
# Must EXACTLY match a callback URL registered on the Atlassian app.
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/jira/callback

# --- Mongo (Atlas free tier or local). DB name is taken from the URI. (REQUIRED) ---
MONGODB_URI=mongodb://localhost:27017/instalog

# --- Token encryption key: 32 bytes, base64. Generate (REQUIRED):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your_base64_32_byte_key_here
